GIGACHAT_CREDENTIALS=your_credentials_here

# Тир модели. По умолчанию (если не задано) — GigaChat-2-Lite, самый дешёвый.
# Не указывайте Pro/Max/Ultra без явной причины — для FAQ-бота Lite достаточно.
GIGACHAT_MODEL=GigaChat-2-Lite

# Через запятую, без пробелов вокруг запятой. В проде — реальный домен сайта.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Куда бот направляет посетителя, если не может ответить по FAQ.
IVAN_TELEGRAM=https://t.me/Ivan_Paro

# Опционально: полностью переопределить системный промпт, не трогая код.
# Если не задано — используется DEFAULT_SYSTEM_PROMPT из backend/app.py.
SYSTEM_PROMPT=
